1384  D03D ED 91 1C 02          nextreg 0x1C,2          ; sprite clip = the play window (screen x 8-247, y 16-127)
1385  D041 ED 91 19 08          nextreg 0x19,8
1386  D045 ED 91 19 F7          nextreg 0x19,247
1387  D049 ED 91 19 10          nextreg 0x19,16
1388  D04D ED 91 19 7F          nextreg 0x19,127
1389  D051 3E 36                ld a,L2PAGE             ; Layer 2 transparent (not stored in the .nex: 48K of one byte)
1390  D053 ED 92 52     .l2:    nextreg 0x52,a
1391  D056 21 00 40             ld hl,0x4000
1392  D059 36 E3                ld (hl),TRANSP
1393  D05B 11 01 40             ld de,0x4001
1394  D05E 01 FF 1F             ld bc,8191
1395  D061 ED B0                ldir
1396  D063 3C                   inc a
1397  D064 FE 3C                cp L2PAGE+6
1398  D066 20 EB                jr nz,.l2
1399  D068 ED 91 52 0A          nextreg 0x52,10
1400  D06C ED 91 12 1B          nextreg 0x12,L2BANK
1401  D070 ED 91 7F 00          nextreg 0x7F,0
1402  D074 01 3B 12             ld bc,0x123B
1403  D077 3E 02                ld a,2                  ; Layer 2 visible
1404  D079 ED 79                out (c),a
1405  D07B ED 91 15 01          nextreg 0x15,0x01       ; sprites on, order S L U
1406  D07F C9                   ret
1407  D080              spal:                           ; 256 sprite palette bytes, then 32 Layer 2 palette bytes (9-bit pairs)
1408  D080              lpal    EQU spal+256
1409  D080
1410  D080                      SAVEBIN "tr_rom.bin",0x386E,rom_end-0x386E
1411  D080                      SAVEBIN "tr_page.bin",0x0100,code_end-0x0100
1412  D080                      SAVEBIN "tr_setup.bin",0xD000,spal-0xD000
1413  D080
# file closed: trueno_hooks.asm
