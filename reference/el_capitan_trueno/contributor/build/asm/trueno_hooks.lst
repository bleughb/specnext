# file opened: trueno_hooks.asm
   1  0000              ; El Capitan Trueno (Dinamic, 1990, 48K) - figures as hardware sprites, foreground in Layer 2.
   2  0000              ; The game plots every figure into a window back buffer (0xF2E0, 30 x 112) and its attribute buffer
   3  0000              ; (0xF13C, 30 x 14); the ISR task 0x8865 copies both to the screen when a render is ready, then
   4  0000              ; restores the scenery under the figures. The plotter already has a "behind the foreground" mode: for
   5  0000              ; a cell set in the foreground map it saves the scenery under the figure (restore list as usual) but
   6  0000              ; draws no pixel and paints no attribute. A data patch (0x87BE) points the plotter at a map of all
   7  0000              ; 0xFF bytes in the ROM (0x3B00, the 48K ROM's unused block, the same in the alt ROM), so no figure
   8  0000              ; reaches the buffer or the attributes: the ULA shows the scenery only (host's idea, 2026-10-13), and
   9  0000              ; every other byte of game memory is as the original. Each figure is shown as sprites instead.
  10  0000              ; Foreground cells of the real map 0xEF60 are copied into Layer 2 with the palette priority bit, so
  11  0000              ; bushes and grass stay in front of the sprites as in the original.
  12  0000              ; Entry/exit stubs live in alt ROM image 1 at 0x386E; hook bodies, state and tables live in Next RAM
  13  0000              ; page PAGE_S, mapped at MMU slot 0 while a hook runs (the game's IM2 handler never touches slot 0;
  14  0000              ; the ISR hooks save and restore the slot 0 page they find).
  15  0000              ;
  16  0000              ; Patch sites (original bytes verified by trueno.py):
  17  0000              ;   0x82DF  DD CB 03 46  BIT 0,(IX+3)   -> JP e_fig  (figure entry: record frame, x, y, flags)
  18  0000              ;   0x88A2  21 08 E6     LD HL,0xE608   -> JP e_cm   (ISR, screen copy done: show the sprites)
  19  0000              ;   0x8865  3A 08 E6     LD A,(0xE608)  -> JP e_tk   (ISR task, every interrupt: pending clear)
  20  0000              ;   0x887D  3F 1F 32     CCF / RRA / LD (0xE608),A -> JP e_shk (ISR: the shaken copy, 8 lines lower,
  21  0000              ;                                                    e.g. Goliath landing: flag it for the commit)
  22  0000              ;   0x6410  21 60 EF     LD HL,0xEF60   -> JP e_scr  (foreground map rebuilt: new screen)
  23  0000              ;   0xA207  21 00 58     LD HL,0x5800   -> JP e_cls  (screen clear: menu, game over)
  24  0000              ;   0xA375  C3 01 A5     JP 0xA501      -> JP e_mnu  (in-game pause menu: Layer 2 and sprites off
  25  0000              ;                                                    while its window is up, 2026-10-13)
  26  0000              ;   0x5DCD  CD 0E 5E     CALL 0x5E0E    -> JP e_end  (screen 60, the end of part 1: the access code
  27  0000              ;                                                    screen, ULA only: Layer 2 and sprites off; the next
  28  0000              ;                                                    game's first screen turns them on, 2026-10-13)
  29  0000              ;   0x889B  21 3C F1     LD HL,0xF13C   -> JP e_att  (ISR copy, attribute source: 0xEF98, the scenery
  30  0000              ;                                                    without figures; screen 34 (the dragon, clear mode):
  31  0000              ;                                                    0xF13C as the original, for its energy bar drawn
  32  0000              ;                                                    via 0x82E4 past the figure hook, 2026-10-13)
  33  0000              ; NextReg 0x7F (user register) carries the requests: bit 0 = rebuild Layer 2 at the next commit,
  34  0000              ; bit 6 = this copy is shaken (8 lines lower), bit 7 = clear Layer 2 and the sprites at the next
  35  0000              ; interrupt. The main-code stubs only write it
  36  0000              ; with NEXTREG (no register, flag or memory change); only the ISR reads it.
  37  0000
  38  0000                      DEVICE ZXSPECTRUMNEXT
  39  0000
  40  0000              PAGE_S  EQU 26                  ; hook page (bank 13, first half)
  41  0000              PAT0    EQU 28                  ; first pattern data page (bank 14 on)
  42  0000              L2BANK  EQU 27                  ; Layer 2: banks 27-29 = pages 54-59 (patterns use banks 14-26)
  43  0000              L2PAGE  EQU 54
  44  0000              MAXF    EQU 64                  ; figures per render
  45  0000              NSPR    EQU 128                 ; sprites / 4-bit patterns
  46  0000              TRANSP  EQU 0xE3                ; Layer 2 transparent colour (NextReg 0x14 default)
  47  0000              BWPAGE  EQU 60                  ; bush and fix cells made on the PC (build/bush_walls.py), pages 60 on:
  48  0000                                              ; page 60 = page per screen (64 bytes, 0 = none), then its offset in
  49  0000                                              ; that page (64 words at 0x40); a screen's block: count, then per cell
  50  0000                                              ; row, column, 64 Layer 2 bytes. Blocks are packed (2026-10-14)
  51  0000              L2COL   EQU 16                  ; Layer 2 palette index 16 + colour (0-7, +8 bright), priority set
  52  0000              L2NP    EQU 32                  ; the same colours without priority (wall ropes, under the sprites)
  53  0000
  54  0000              G_FLAGS EQU 0xE608              ; bit 0 = render ready (the ISR copies it)
  55  0000              G_MODE  EQU 0xE60B              ; 34 = clear mode (blank buffer)
  56  0000              G_MAP   EQU 0xEF60              ; foreground cell map: 4 bytes per cell row, 14 rows, bit 7 = column 0
  57  0000              G_ATTR  EQU 0xEF98              ; window attributes without figures, 30 x 14
  58  0000              G_BUF   EQU 0xF2E0              ; window pixels, 30 bytes x 112 lines (screen x 8, y 16)
  59  0000
  60  0000              ; ---- hook page layout ----
  61  0000              V_SP    EQU 0x0000              ; game SP in the figure hook
  62  0000              V_SP2   EQU 0x0002              ; game SP in the ISR hooks
  63  0000              V_SLOT0 EQU 0x0004              ; slot 0 page found by an ISR hook
  64  0000              V_N     EQU 0x0005              ; figures recorded this render
  65  0000              V_PREV  EQU 0x0006              ; sprites shown now
  66  0000              V_NEXT  EQU 0x0007              ; next free 4-bit pattern
  67  0000              V_S     EQU 0x0008              ; next sprite (commit)
  68  0000              V_OVF   EQU 0x0009              ; pattern memory full in this pass
  69  0000              V_PAT   EQU 0x000A              ; figure: first pattern
  70  0000              V_FX    EQU 0x000B              ; figure: descriptor x, y, flags
  71  0000              V_FY    EQU 0x000C
  72  0000              V_FF    EQU 0x000D
  73  0000              V_COLS  EQU 0x000E
  74  0000              V_ROWS  EQU 0x000F
  75  0000              V_DX    EQU 0x0010
  76  0000              V_DY    EQU 0x0011
  77  0000              V_PADS  EQU 0x0012
  78  0000              V_MX    EQU 0x0013
  79  0000              V_MY    EQU 0x0014
  80  0000              V_ATTR2 EQU 0x0015
  81  0000              V_X0    EQU 0x0016              ; 2: box x in sprite coordinates
  82  0000              V_Y0    EQU 0x0018
  83  0000              V_R     EQU 0x0019
  84  0000              V_C     EQU 0x001A
  85  0000              V_RSRC  EQU 0x001C              ; 2: Layer 2 pass: buffer row of this cell row
  86  0000              V_RATT  EQU 0x001E              ; 2: attribute row
  87  0000              V_NEW   EQU 0x0020              ; 2: the map to show
  88  0000              V_LDST  EQU 0x0022              ; 2: Layer 2 address of the cell
  89  0000              V_INK   EQU 0x0024              ; Layer 2 colours of the cell
  90  0000              V_PAP   EQU 0x0025
  91  0000              V_LY    EQU 0x0028              ; Layer 2 pass: first screen line of the cell row
  92  0000              V_LN    EQU 0x0029              ; line in the cell row (0-7)
  93  0000              V_C0    EQU 0x002A              ; run of foreground cells: first, last column
  94  0000              V_C1    EQU 0x002B
  95  0000              V_XL    EQU 0x002C              ; leftmost / rightmost ink pixel of the run, current x
  96  0000              V_XR    EQU 0x002D
  97  0000              V_X     EQU 0x002E
  98  0000              V_REQ   EQU 0x002F              ; NextReg 0x7F as read by the commit
  99  0000              V_SHK   EQU 0x0030              ; 8 when this copy is shaken, else 0
 100  0000              V_LI    EQU 0x0031              ; rope cell: left neighbour ink, paper (Layer 2 indices)
 101  0000              V_LP    EQU 0x0032
 102  0000              V_RI    EQU 0x0033              ; right neighbour ink, paper
 103  0000              V_RP    EQU 0x0034
 104  0000              V_RT    EQU 0x0035              ; 2: rope mask table, current row
 105  0000              V_FAC   EQU 0x0026              ; figure: stored facing (bit 7)
 106  0000              V_BLK   EQU 0x0027              ; renders shown (bit 0: blink phase)
 107  0000              V_BW    EQU 0x0036              ; 1 = this screen's bush cells came from the table (no pass 2b)
 108  0000              STK1    EQU 0x0100              ; figure hook stack (0x0040-0x00FF; the ISR may push 34 bytes on it)
 109  0000              RESF    EQU 0x0F00              ; per frame: first pattern + 1 of its hit-flash shape
 110  0000              FIGS    EQU 0x1000              ; MAXF x (frame, x, y, flags)
 111  0000              RES     EQU 0x1100              ; per frame: first pattern + 1 (0 = not in pattern memory)
 112  0000              SDIR    EQU 0x1200              ; per frame (220 x 8): page, first | facing << 7, cols, rows, dx, dy, pads, mdx
 113  0000              OLDMAP  EQU 0x1900              ; the foreground map Layer 2 shows now (56 bytes)
 114  0000              ZMAP    EQU 0x1940              ; 56 zero bytes (the empty map)
 115  0000              OLDROPE EQU 0x1980              ; the rope cells Layer 2 shows now (56 bytes, map layout)
 116  0000              FDIR    EQU 0x1A00              ; per frame (220 x 2): page, first of its hit-flash silhouette shape
 117  0000              BLINK   EQU 0x1C00              ; per frame: 1 = the hit flash blinks (normal / silhouette)
 118  0000              STK2    EQU 0x2000              ; ISR hook stack (0x1D00-0x1FFF)
 119  0000
