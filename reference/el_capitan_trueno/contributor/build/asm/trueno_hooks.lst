 168  38DD ED 91 7F 01  e_scr:  nextreg 0x7F,1          ; new screen: rebuild Layer 2 at the next commit (drops a pending clear:
 169  38E1                                              ; the rebuild clears every cell that is not foreground any more)
 170  38E1 ED 91 69 80          nextreg 0x69,0x80       ; Layer 2 on (off if the pause menu was left without its RET)
 171  38E5 ED 91 50 1A          nextreg 0x50,PAGE_S     ; forget the figures recorded so far in this render: they belong to
 172  38E9 21 05 00             ld hl,V_N               ; the old screen (the original overwrites them in the buffer; here
 173  38EC 36 00                ld (hl),0               ; they showed as sprites on the new screen's first copy). HL is set next
 174  38EE ED 91 50 FF          nextreg 0x50,0xFF
 175  38F2 ED 91 15 00          nextreg 0x15,0x00       ; sprites off until the next commit: the copy takes most of a frame,
 176  38F6                                              ; the old sprites flashed over the new screen meanwhile
 177  38F6 21 60 EF             ld hl,G_MAP
